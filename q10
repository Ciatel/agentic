from crewai import Agent as CrewAgent, Crew, LLM, Process, Task

info = yf.Ticker("AAPL").info
stock_data = f"Price={info.get('currentPrice')}, PE={info.get('trailingPE')}"

crew_llm = LLM(
    model="openai/openai/gpt-oss-20b",
    base_url="https://api.groq.com/openai/v1",
    api_key=os.environ["GROQ_API_KEY"],
    max_tokens=300,
)

analyst = CrewAgent(role="Stock Analyst", goal="Analyze stock data", backstory="Finance analyst", llm=crew_llm)
writer = CrewAgent(role="Report Writer", goal="Write a short report", backstory="Finance writer", llm=crew_llm)

analysis = Task(description=f"Analyze AAPL: {stock_data}", expected_output="Strengths and risks", agent=analyst)
